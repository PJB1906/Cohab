DATABASE_URL=postgresql+psycopg://cohab:cohab@localhost:5432/cohab

# Session-cookie JWT signing key. Change this for any non-local deployment —
# anyone holding it can forge a session for any user.
SECRET_KEY=dev-only-change-me

# False for local http development (the browser won't set a Secure cookie
# over plain http); True in any real deployment, which is same-origin https
# per CLAUDE.md.
COOKIE_SECURE=False

# Optional. Unset (default) keeps OTPs logged to the console only — set this
# to send real verification emails via Resend (https://resend.com) instead.
# The sandbox sender (OTP_SENDER_EMAIL's default) only delivers to the email
# address the Resend account itself was signed up with, until a real sending
# domain is verified in the Resend dashboard.
RESEND_API_KEY=
OTP_SENDER_EMAIL=onboarding@resend.dev

# Alternative to Resend: plain SMTP, checked first if set. No domain/DNS
# verification needed — works for any recipient. Use a throwaway mailbox's
# app-password SMTP (e.g. a fresh Gmail account, smtp.gmail.com:587), not a
# personal one. OTP_SENDER_EMAIL above is reused as the From address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 — object storage for user-uploaded images (avatars, listing
# photos), replacing local-disk UPLOAD_DIR on deployments with an ephemeral
# filesystem. Not yet wired into services/uploads.py — placeholders only
# until the proxy-vs-direct-serving decision is made (docs/DECISIONS.md).
# R2_ENDPOINT_URL is the bucket's "S3 API" URL shown on its Settings page.
# R2_PUBLIC_URL is the Public Development URL (or a connected custom domain).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cohab-uploads
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
